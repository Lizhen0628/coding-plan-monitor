<Window x:Class="CodingPlanMonitor.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Width="360" SizeToContent="Height" ShowInTaskbar="False" Topmost="True"
        ResizeMode="NoResize" KeyDown="Window_KeyDown">
    <Border x:Name="RootBorder" CornerRadius="10" BorderThickness="1" BorderBrush="#FFD8D8DC"
            Background="White" Padding="12" Margin="0,0,8,8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.22" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 头部 -->
            <Grid Grid.Row="0">
                <TextBlock Text="Coding Plan Monitor" FontSize="14" FontWeight="SemiBold"
                           Foreground="#FF1D1D1F"/>
                <TextBlock x:Name="LoadingText" Text="刷新中…" FontSize="11" Foreground="#FF8E8E93"
                           HorizontalAlignment="Right" Visibility="Collapsed"/>
            </Grid>

            <!-- 账号列表 / 空态 -->
            <Grid Grid.Row="1" Margin="0,8,0,0">
                <StackPanel x:Name="EmptyState" Visibility="Collapsed" Margin="0,4,0,4">
                    <TextBlock Text="🔑" FontSize="22" HorizontalAlignment="Center"/>
                    <TextBlock Text="尚未添加账号" FontSize="13" Foreground="#FF1D1D1F"
                               HorizontalAlignment="Center" Margin="0,4,0,8"/>
                    <Button x:Name="EmptySettingsButton" Content="打开设置…"
                            HorizontalAlignment="Center" Padding="10,4"/>
                </StackPanel>
                <ScrollViewer x:Name="ListScroller" MaxHeight="500" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="AccountList"/>
                </ScrollViewer>
            </Grid>

            <!-- 状态行 -->
            <Border Grid.Row="2" Height="1" Background="#FFE6E6EA" Margin="0,8,0,8"/>
            <Grid Grid.Row="3">
                <TextBlock x:Name="LastRefreshText" Text="尚未刷新" FontSize="12" Foreground="#FF6E6E73"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#FF8E8E93" Margin="0,0,4,0"/>
                    <TextBlock x:Name="StatusText" Text="未知" FontSize="12" Foreground="#FF6E6E73"/>
                </StackPanel>
            </Grid>

            <!-- 操作按钮 -->
            <Border Grid.Row="4" Height="1" Background="#FFE6E6EA" Margin="0,8,0,8"/>
            <StackPanel Grid.Row="5" x:Name="ActionsPanel"/>
        </Grid>
    </Border>
</Window>
