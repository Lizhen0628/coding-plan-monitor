<Window x:Class="CodingPlanMonitor.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置 - Coding Plan Monitor" Width="680" Height="470"
        MinWidth="580" MinHeight="400"
        WindowStartupLocation="CenterScreen" Background="#FFF5F5F7">
    <TabControl Margin="10" Background="Transparent" BorderThickness="0">
        <TabItem Header="账号">
            <Grid Margin="4,8,4,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：账号列表 -->
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="AddButton" Content="＋ 添加账号" Padding="10,3"/>
                        <Button x:Name="RemoveButton" Content="－" Padding="10,3" Margin="6,0,0,0"
                                ToolTip="删除选中账号"/>
                    </StackPanel>
                    <ListBox x:Name="AccountListBox" BorderThickness="1" BorderBrush="#FFE0E0E0"
                             Background="White" Padding="2"/>
                </DockPanel>

                <!-- 右侧：账号详情 -->
                <Border Grid.Column="1" Margin="10,0,0,0" Background="White" BorderBrush="#FFE0E0E0"
                        BorderThickness="1" CornerRadius="6" Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="DetailPanel"/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </TabItem>

        <TabItem Header="通用">
            <StackPanel Margin="20,16,20,16">
                <TextBlock Text="系统托盘" FontWeight="SemiBold" FontSize="13"/>
                <CheckBox x:Name="ShowUsageCheck" Content="在托盘图标上显示用量百分比" Margin="0,8,0,0"/>
                <TextBlock Text="关闭后托盘仅显示仪表盘图标，用量信息仍可在面板与悬停提示中查看"
                           FontSize="11" Foreground="#FF8E8E93" Margin="22,3,0,0" TextWrapping="Wrap"/>
                <Separator Margin="0,16"/>
                <TextBlock Text="刷新" FontWeight="SemiBold" FontSize="13"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="自动刷新间隔：" VerticalAlignment="Center"/>
                    <ComboBox x:Name="RefreshCombo" Width="70" Padding="4,2"/>
                    <TextBlock Text=" 分钟" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="京ICP备2026039913号-2A"
                           FontSize="11" Foreground="#FF8E8E93"
                           HorizontalAlignment="Center" Margin="0,24,0,0"/>
            </StackPanel>
        </TabItem>
    </TabControl>
</Window>
